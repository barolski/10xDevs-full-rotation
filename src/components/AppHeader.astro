---
// Shared app header, rendered by Layout on every page: home, the organizer's entry, sign in/out and the
// player's theme choice (Light / Dark / System).
import { LogIn, LogOut } from "lucide-react";
import ThemeToggle from "@/components/ThemeToggle";
import { buttonVariants } from "@/components/ui/button";

const { user, isOrganizer } = Astro.locals;
const home = user ? "/dashboard" : "/";
const onAuthPage = Astro.url.pathname.startsWith("/auth/");
const onOrganizerPage = Astro.url.pathname === "/organizer" || Astro.url.pathname.startsWith("/organizer/");
---

<header class="border-border bg-background/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between gap-3 px-4">
    <a
      href={home}
      class="focus-visible:ring-ring rounded-md text-base font-semibold tracking-tight outline-none focus-visible:ring-2"
    >
      FullRotation
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2">
      {isOrganizer && (
        <a
          href="/organizer"
          aria-current={onOrganizerPage ? "page" : undefined}
          class:list={[
            buttonVariants({ variant: "ghost", size: "sm" }),
            onOrganizerPage && "bg-accent text-accent-foreground",
          ]}
        >
          Trainings
        </a>
      )}
      {user ? (
        <form method="POST" action="/api/auth/signout">
          <button type="submit" class:list={[buttonVariants({ variant: "ghost", size: "sm" })]}>
            <LogOut aria-hidden="true" />
            <span class="sr-only sm:not-sr-only">Sign out</span>
          </button>
        </form>
      ) : (
        !onAuthPage && (
          <a href="/auth/signin" class:list={[buttonVariants({ variant: "ghost", size: "sm" })]}>
            <LogIn aria-hidden="true" />
            Sign in
          </a>
        )
      )}
      <ThemeToggle compact client:load />
    </nav>
  </div>
</header>
