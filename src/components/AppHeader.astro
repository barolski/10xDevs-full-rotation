---
// Shared app header, rendered by Layout on every page: home, the organizer's entry, sign in, the signed-in
// account menu (profile, theme choice Light / Dark, sign out) and, signed out, the theme toggle.
import { LogIn } from "lucide-react";
import ThemeToggle from "@/components/ThemeToggle";
import { t } from "@/i18n";
import { buttonVariants } from "@/components/ui/button";

const { user, isOrganizer, lang } = Astro.locals;
const dictionary = t(lang);
const home = user ? "/dashboard" : "/";
const onAuthPage = Astro.url.pathname.startsWith("/auth/");
const onOrganizerPage = Astro.url.pathname === "/organizer" || Astro.url.pathname.startsWith("/organizer/");
const onDashboard = Astro.url.pathname === "/dashboard" || Astro.url.pathname.startsWith("/dashboard/");
// Avatar shows the first letter of the account email; profile names are not loaded on every request.
const initial = user?.email?.charAt(0).toUpperCase() ?? "?";
// The home page carries its own centered "Sign in" button, so the header link is hidden there for signed-out visitors.
const onHome = Astro.url.pathname === "/";
---

<header class="border-border bg-background/90 sticky top-0 z-40 border-b backdrop-blur">
  <div class="mx-auto flex h-14 w-full max-w-5xl items-center justify-between gap-3 px-4">
    <a
      href={home}
      class="focus-visible:ring-ring rounded-md text-base font-semibold tracking-tight outline-none focus-visible:ring-2"
    >
      Full Rotation
    </a>
    <nav aria-label={dictionary.header.mainNav} class="flex items-center gap-1 sm:gap-2">
      {isOrganizer && (
        <a
          href="/organizer"
          aria-current={onOrganizerPage ? "page" : undefined}
          class:list={[
            buttonVariants({ variant: "ghost", size: "sm" }),
            onOrganizerPage && "bg-accent text-accent-foreground",
          ]}
        >
          {dictionary.header.trainings}
        </a>
      )}
      {user ? (
        <>
          <a
            href="/dashboard"
            aria-current={onDashboard ? "page" : undefined}
            class:list={[
              buttonVariants({ variant: "ghost", size: "sm" }),
              onDashboard && "bg-accent text-accent-foreground",
            ]}
          >
            {dictionary.header.dashboard}
          </a>
          <details data-user-menu class="relative">
            <summary
              aria-label={dictionary.header.accountMenu}
              class="bg-info text-background focus-visible:ring-ring flex size-8 cursor-pointer list-none items-center justify-center rounded-full text-sm font-semibold outline-none focus-visible:ring-2 [&::-webkit-details-marker]:hidden"
            >
              {initial}
            </summary>
            <div class="bg-popover text-popover-foreground border-border absolute top-full right-0 z-50 mt-2 flex min-w-40 flex-col gap-1 rounded-md border p-1 shadow-md">
              <a
                href="/profile"
                class="hover:bg-accent hover:text-accent-foreground focus-visible:ring-ring rounded-sm px-2 py-1.5 text-sm outline-none focus-visible:ring-2"
              >
                {dictionary.header.profile}
              </a>
              <div class="border-border my-1 border-t"></div>
              <ThemeToggle lang={lang} menu client:load />
              <div class="border-border my-1 border-t"></div>
              <form method="POST" action="/api/auth/signout">
                <button
                  type="submit"
                  class="hover:bg-accent hover:text-accent-foreground focus-visible:ring-ring w-full rounded-sm px-2 py-1.5 text-left text-sm outline-none focus-visible:ring-2"
                >
                  {dictionary.header.signOut}
                </button>
              </form>
            </div>
          </details>
        </>
      ) : (
        !onAuthPage &&
        !onHome && (
          <a href="/auth/signin" class:list={[buttonVariants({ variant: "ghost", size: "sm" })]}>
            <LogIn aria-hidden="true" />
            {dictionary.header.signIn}
          </a>
        )
      )}
      {!user && <ThemeToggle lang={lang} compact client:load />}
    </nav>
  </div>
</header>

<script>
  // Closes an open account menu on a click outside it or on Escape.
  function closeOpenMenus(except?: Element | null) {
    document.querySelectorAll<HTMLDetailsElement>("details[data-user-menu][open]").forEach((menu) => {
      if (menu !== except) menu.open = false;
    });
  }

  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    closeOpenMenus(target?.closest("details[data-user-menu]"));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeOpenMenus();
  });
</script>
