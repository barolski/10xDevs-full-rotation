---
// One roster (main list or waitlist), rendered by name. Shared by both lists so they can never drift.
import { rosterLabel } from "@/lib/profiles";
import type { SignupEntry } from "@/lib/signups";

interface Props {
  title: string;
  // Only user_id and nickname are rendered, so the roster-status buckets (blocked, no response),
  // which have no queue position, fit the same list as main and waitlist.
  entries: Pick<SignupEntry, "user_id" | "nickname">[];
  emptyLabel: string;
  // The signed-in player, marked on their own row.
  highlightUserId?: string;
  // Shown next to the title, e.g. "8/12". Omitted for the waitlist, which has no cap.
  count?: string;
  // The 1-based queue number on each row. Off for lists without a queue order (blocked, no response).
  showRank?: boolean;
}

const { title, entries, emptyLabel, highlightUserId, count, showRank = true } = Astro.props;
---

<section class="space-y-2">
  <h2 class="flex items-baseline justify-between gap-2 text-sm font-medium">
    <span>{title}</span>
    {count && <span class="text-muted-foreground text-xs tabular-nums">{count}</span>}
  </h2>
  {entries.length === 0 ? (
    <p class="text-muted-foreground rounded-lg border border-dashed p-3 text-center text-sm">{emptyLabel}</p>
  ) : (
    <ol class="space-y-0.5 rounded-lg border p-1.5">
      {entries.map((entry, index) => {
        // The signed-in player's row is highlighted as a rounded inset pill, not a full-bleed band:
        // the list has inner padding and gaps, so the accent fill is a self-contained rounded cell
        // with its own corners. The accent pair (background + matching foreground) keeps it readable
        // in both themes, where a translucent tint alone would wash out in the dark theme.
        const isMe = entry.user_id === highlightUserId;
        return (
          <li
            class:list={[
              "flex items-center gap-3 rounded-md px-2.5 py-1.5 text-sm",
              isMe && "bg-accent text-accent-foreground font-medium",
            ]}
          >
            {showRank && (
              <span
                class:list={[
                  "w-5 text-right text-xs tabular-nums",
                  isMe ? "text-accent-foreground/80" : "text-muted-foreground",
                ]}
              >
                {index + 1}
              </span>
            )}
            <span class="min-w-0 break-words">{rosterLabel(entry)}</span>
            {isMe && <span class="ml-auto text-xs font-semibold tracking-wide uppercase">you</span>}
          </li>
        );
      })}
    </ol>
  )}
</section>
