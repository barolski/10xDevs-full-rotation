---
// The organizer's Roster section (S-08, FR-011): four lists for one training. Shared by the training
// screen and the kitchen-sink, so the states the gate shows are the states the screen renders.
import { Alert, AlertDescription } from "@/components/ui/alert";
import RosterList from "@/components/trainings/RosterList.astro";
import type { RosterStatus } from "@/lib/roster-status";
import { MAIN_LIST_SIZE } from "@/lib/signups";

interface Props {
  // Null when the load failed (or there is no training); the failure branch then renders.
  status: RosterStatus | null;
  failed: boolean;
}

const { status, failed } = Astro.props;
---

<section class="space-y-3">
  <h2 class="text-sm font-medium">Roster</h2>
  {failed || !status ? (
    <Alert variant="destructive">
      <AlertDescription>
        Could not load the roster (main list —, waitlist —, blocked —, no response —). Please refresh the page.
      </AlertDescription>
    </Alert>
  ) : (
    <div class="space-y-4">
      <RosterList
        title="Main list"
        count={`${status.main.length} / ${MAIN_LIST_SIZE}`}
        entries={status.main}
        emptyLabel="No one on the main list yet."
      />
      <RosterList title="Waitlist" entries={status.waitlist} emptyLabel="No one on the waitlist." />
      <RosterList
        title="Blocked (not signed up)"
        count={String(status.blocked.length)}
        entries={status.blocked}
        emptyLabel="No one without a sign-up is blocked."
        showRank={false}
      />
      <RosterList
        title="No response"
        count={String(status.noResponse.length)}
        entries={status.noResponse}
        emptyLabel="Everyone has responded."
        showRank={false}
      />
    </div>
  )}
</section>
