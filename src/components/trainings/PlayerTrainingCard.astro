---
// The player's view of one training (/t/[id]); also rendered by /dev/training-kitchen-sink so the gate
// shows the same markup the page ships.
import { CircleCheck, CircleX, DoorOpen, Hourglass } from "lucide-react";
import SignupPanel from "@/components/trainings/SignupPanel.astro";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import type { Placement, Roster } from "@/lib/signups";
import {
  isSignupOpen,
  TRAINING_STATUS_BADGE,
  trainingDisplayStatus,
  type Training,
  type TrainingDisplayStatus,
} from "@/lib/trainings";

// One lucide glyph per display status; the label + colour come from TRAINING_STATUS_BADGE.
const STATUS_ICON: Record<TrainingDisplayStatus, typeof CircleCheck> = {
  open: DoorOpen,
  finalizing: Hourglass,
  confirmed: CircleCheck,
  cancelled: CircleX,
};

interface Props {
  training: Training | null;
  unavailable: { title: string; message: string };
  now: Date;
  isOrganizer?: boolean;
  roster: Roster;
  placement: Placement | null;
  userId?: string;
  // True when the roster lookup failed, as opposed to nobody having signed up.
  rosterFailed?: boolean;
  notice?: "signed_up" | "withdrawn" | null;
  error?: string | null;
}

const {
  training,
  unavailable,
  now,
  isOrganizer = false,
  roster,
  placement,
  userId,
  rosterFailed = false,
  notice = null,
  error = null,
} = Astro.props;
const open = training ? isSignupOpen(new Date(training.starts_at), now) : false;
const display = training ? trainingDisplayStatus(training, now) : null;
const badge = display ? TRAINING_STATUS_BADGE[display] : null;
const StatusIcon = display ? STATUS_ICON[display] : null;
---

<Card className="w-full">
  {training ? (
    <>
      <CardHeader className="gap-3">
        <span class:list={[badgeVariants({ variant: badge?.variant })]}>
          {StatusIcon && <StatusIcon className="size-3.5" aria-hidden="true" />}
          {badge?.label}
        </span>
        <CardTitle className="text-2xl leading-tight font-semibold tracking-tight text-balance break-words">
          <h1>{training.title}</h1>
        </CardTitle>
      </CardHeader>
      <CardContent>
        {/* SignupPanel owns the details too, so it can put them beside the rosters when there is room. */}
        <SignupPanel
          training={training}
          now={now}
          roster={roster}
          placement={placement}
          userId={userId}
          open={open}
          failed={rosterFailed}
          notice={notice}
          error={error}
        />
      </CardContent>
      {isOrganizer && (
        <CardFooter className="border-t">
          <a href={`/organizer/trainings/${training.id}`} class:list={[buttonVariants({ variant: "outline" })]}>
            Manage
          </a>
        </CardFooter>
      )}
    </>
  ) : (
    <>
      <CardHeader>
        <CardTitle className="text-2xl leading-tight font-semibold tracking-tight">
          <h1>{unavailable.title}</h1>
        </CardTitle>
      </CardHeader>
      <CardContent>
        <p class="text-muted-foreground text-sm">{unavailable.message}</p>
      </CardContent>
    </>
  )}
</Card>
