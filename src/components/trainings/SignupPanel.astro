---
// The player's view of one training's body on /t/[id]: details and the sign-up action on top, then
// the main list and the waitlist beside it once there is room for two columns (stacked below that).
// Also rendered by /dev/training-kitchen-sink, so the gate shows the markup the page ships.
//
// The breakpoint is a container query, not a viewport one: this panel is rendered both full-width on
// the page and inside narrow kitchen-sink cards, and it should follow its own width in each.
import { CircleAlert, CircleCheck, Users } from "lucide-react";
import RosterList from "@/components/trainings/RosterList.astro";
import SpotsMeter from "@/components/trainings/SpotsMeter.astro";
import TrainingDetails from "@/components/trainings/TrainingDetails.astro";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { t } from "@/i18n";
import { cn } from "@/lib/utils";
import { MAIN_LIST_SIZE, signupErrorMessage, type Placement, type Roster } from "@/lib/signups";
import { canWithdraw, type Training } from "@/lib/trainings";
import { blockReason } from "@/lib/attendance";

interface Props {
  training: Training;
  now: Date;
  roster: Roster;
  placement: Placement | null;
  userId?: string;
  open: boolean;
  // True when the roster lookup itself failed: a temporary failure must not read as "nobody signed up".
  failed: boolean;
  // The no-show lockout (S-07, FR-010): when true, the block reason replaces the sign-up action.
  blocked?: boolean;
  absences?: number;
  notice?: "signed_up" | "withdrawn" | null;
  error?: string | null;
}

const {
  training,
  now,
  roster,
  placement,
  userId,
  open,
  failed,
  blocked = false,
  absences = 0,
  notice = null,
  error = null,
} = Astro.props;

const { lang } = Astro.locals;
const d = t(lang).signup;
const errorMessage = signupErrorMessage(error, lang);
const noticeMessage = notice === "signed_up" ? d.notice.signedUp : notice === "withdrawn" ? d.notice.withdrawn : null;

// Withdrawal outlives the sign-up window: a confirmed training accepts it until it starts, so the
// first waitlisted player can be promoted (FR-016). Sign up stays gated to `open`. `lateWithdraw` is
// the confirmed-before-start case, where the action carries a warning that it may count as an absence.
const showWithdraw = placement !== null && canWithdraw(training, now);
// A blocked player sees the reason instead of the sign-up action (FR-010); the DB trigger is still
// the hard gate if they POST directly.
const showSignup = placement === null && open && !blocked;
const showBlocked = placement === null && open && blocked;
const lateWithdraw = showWithdraw && !open;
---

<div class="@container space-y-4">
  {errorMessage && (
    <Alert variant="destructive">
      <CircleAlert />
      <AlertDescription>{errorMessage}</AlertDescription>
    </Alert>
  )}

  {/* Two columns from @2xl: the action column (notice, status, meter, button, details) beside the rosters;
      stacked below that, where each list would be too narrow for a name, rank and the "you" pill. */}
  <div class="grid items-start gap-6 @2xl:grid-cols-[minmax(0,20rem)_minmax(0,1fr)]">
    <div class="space-y-4">
      {noticeMessage && !errorMessage && (
        <Alert>
          <CircleCheck />
          <AlertDescription>{noticeMessage}</AlertDescription>
        </Alert>
      )}

      {/* The player's own status comes first: it is the one fact they opened the link for.
          Suppressed entirely when the roster could not be read: an empty roster would otherwise be
          reported as twelve free slots, and a player already on the list would be offered Sign up. */}
      {!failed && (
        <div class="space-y-4">
          {placement && (
            <p class="flex flex-wrap items-center gap-2">
              <span class:list={[badgeVariants({ variant: placement.list === "main" ? "success" : "secondary" })]}>
                {placement.list === "main" ? (
                  <CircleCheck className="size-3.5" aria-hidden="true" />
                ) : (
                  <Users className="size-3.5" aria-hidden="true" />
                )}
                {placement.list === "main" ? d.mainList : d.waitlist}
                <span class="tabular-nums">#{placement.rank}</span>
              </span>
              <span class="text-muted-foreground text-sm">
                {placement.list === "main" ? d.youAreIn : d.youWillMoveUp}
              </span>
            </p>
          )}

          <SpotsMeter taken={roster.main.length} />

          {showWithdraw && (
            <form method="POST" action={`/api/trainings/${training.id}/withdraw`} class="space-y-2">
              <button type="submit" class:list={[cn(buttonVariants({ variant: "outline", size: "lg" }), "w-full")]}>
                {d.withdraw}
              </button>
              {lateWithdraw && <p class="text-muted-foreground text-xs">{d.lateWithdrawNote}</p>}
            </form>
          )}
          {showSignup && (
            <form method="POST" action={`/api/trainings/${training.id}/signup`} data-signup-form>
              <button
                type="submit"
                data-signing-up-label={d.signingUp}
                class:list={[cn(buttonVariants({ size: "lg" }), "w-full")]}
              >
                {d.signUp}
              </button>
            </form>
          )}
          {showBlocked && (
            <p role="alert" class="bg-destructive-soft text-destructive-strong rounded-lg px-3 py-2 text-sm">
              {blockReason(absences, lang)}
            </p>
          )}
        </div>
      )}

      <div class="border-t pt-4">
        <TrainingDetails training={training} now={now} hideInBand />
      </div>
    </div>

    {failed ? (
      <p class="text-muted-foreground rounded-lg border border-dashed p-4 text-center text-sm">{d.rosterUnavailable}</p>
    ) : (
      <div class="grid items-start gap-4 @5xl:grid-cols-2">
        {/* The waitlist always renders so the two lists keep the same shape when it is empty. */}
        <RosterList
          title={d.mainList}
          entries={roster.main}
          emptyLabel={d.emptyMain}
          highlightUserId={userId}
          count={`${roster.main.length}/${MAIN_LIST_SIZE}`}
        />
        <RosterList
          title={d.waitlist}
          entries={roster.waitlist}
          emptyLabel={d.emptyWaitlist}
          highlightUserId={userId}
          count={String(roster.waitlist.length)}
        />
      </div>
    )}
  </div>
</div>

<script>
  // The submit event has fired by the time this runs; disabling the button inside the click handler would
  // cancel the POST, so wait one tick.
  document.querySelectorAll<HTMLFormElement>("form[data-signup-form]").forEach((form) => {
    form.addEventListener("submit", () => {
      const button = form.querySelector<HTMLButtonElement>("button[type=submit]");
      if (!button) return;
      const label = button.textContent;
      setTimeout(() => {
        button.disabled = true;
        button.textContent = button.dataset.signingUpLabel ?? label;
      }, 0);
      // Back/forward cache restores the page as it was left: put the button back.
      window.addEventListener(
        "pageshow",
        (event) => {
          if (!event.persisted) return;
          button.disabled = false;
          button.textContent = label;
        },
        { once: true },
      );
    });
  });
</script>
