---
type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

// Status tokens from global.css, so the banner follows the player's light/dark choice.
const tone: Record<Variant, string> = {
  info: "bg-info-soft text-info-strong border-info",
  warning: "bg-warning-soft text-warning-strong border-warning",
  error: "bg-destructive-soft text-destructive-strong border-destructive",
};
---

<div
  class:list={[
    "border-b px-4 py-3 text-center text-sm [&_a]:font-semibold [&_a]:underline [&_a]:underline-offset-4",
    tone[variant],
  ]}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>
