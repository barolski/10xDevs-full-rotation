---
import "@fontsource-variable/manrope";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import AppHeader from "@/components/AppHeader.astro";
import Banner from "@/components/Banner.astro";
import { missingConfigs } from "@/lib/config-status";
import { t } from "@/i18n";
import { THEME_STORAGE_KEY } from "@/lib/theme";

interface Props {
  title?: string;
  // Forces a token set from global.css (`.dark` or plain `:root`), e.g. for the dev kitchen sinks.
  // Without it the player's stored choice (ThemeToggle) or the system setting decides, before first paint.
  theme?: "dark" | "light";
}

const { title = "FullRotation", theme } = Astro.props;
const lang = Astro.locals.lang;
const dictionary = t(lang);
---

<!doctype html>
<html lang={lang} class:list={[{ dark: theme === "dark" }]} data-theme-forced={theme}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    {!theme && <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
      // Pre-paint copy of readThemePreference/applyThemePreference in src/lib/theme.ts: keep the two in sync.
      (function () {
        var preference = "system";
        try {
          preference = window.localStorage.getItem(storageKey) || "system";
        } catch (e) {
          // Storage unavailable: follow the system setting.
        }
        var dark =
          preference === "dark" ||
          (preference !== "light" && !!window.matchMedia && window.matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.classList.toggle("dark", dark);
      })();
    </script>}
  </head>
  <body class="flex min-h-dvh flex-col">
    {missingConfigs.map((cfg) => (
      <Banner variant="error">
        <strong>{dictionary.config.attention}</strong> {dictionary.config.items[cfg.key].message}
        {cfg.docsUrl && (
          <>
            {" "}
            <a href={cfg.docsUrl} target="_blank" rel="noopener noreferrer">
              {dictionary.config.items[cfg.key].docsLabel}
            </a>
            .
          </>
        )}
      </Banner>
    ))}
    <AppHeader />
    <div class="flex flex-1 flex-col">
      <slot />
    </div>
  </body>
</html>
