---
import { CircleCheck, MailCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { t } from "@/i18n";
import { safeNext, withNext } from "@/lib/redirect";

const next = safeNext(Astro.url.searchParams.get("next"));
const d = t(Astro.locals.lang).auth.confirmEmail;
const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      Icon: CircleCheck,
      tone: "bg-success-soft text-success-strong",
      heading: d.registered.heading,
      description: d.registered.description,
      linkText: d.registered.link,
    }
  : {
      Icon: MailCheck,
      tone: "bg-info-soft text-info-strong",
      heading: d.checkInbox.heading,
      description: d.checkInbox.description,
      linkText: d.checkInbox.link,
    };
---

<Layout title={content.heading}>
  <main class="flex flex-1 items-center justify-center p-4">
    <Card className="w-full max-w-sm text-center">
      <CardHeader className="justify-items-center gap-3">
        <span class:list={["inline-flex size-12 items-center justify-center rounded-full", content.tone]}>
          <content.Icon className="size-6" aria-hidden="true" />
        </span>
        <CardTitle className="text-2xl">
          <h1>{content.heading}</h1>
        </CardTitle>
        <CardDescription>{content.description}</CardDescription>
      </CardHeader>
      <CardContent>
        <a
          href={withNext("/auth/signin", next)}
          class="text-foreground hover:decoration-primary text-sm underline underline-offset-4"
        >
          {content.linkText}
        </a>
      </CardContent>
    </Card>
  </main>
</Layout>
