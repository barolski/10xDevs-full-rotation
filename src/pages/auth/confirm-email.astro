---
import Layout from "@/layouts/Layout.astro";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

const isAutoConfirmed = import.meta.env.DEV;

const content = isAutoConfirmed
  ? {
      emoji: "✅",
      heading: "Registration successful",
      description: "Your account has been created. You can now sign in.",
      linkText: "Go to sign in",
    }
  : {
      emoji: "📧",
      heading: "Check your email",
      description: "We've sent a confirmation link to your email address. Click it to activate your account.",
      linkText: "Back to sign in",
    };
---

<Layout title={content.heading}>
  <main class="bg-background flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm text-center">
      <CardHeader>
        <div class="mb-2 text-5xl" aria-hidden="true">
          {content.emoji}
        </div>
        <CardTitle className="text-2xl">
          <h1>{content.heading}</h1>
        </CardTitle>
        <CardDescription>{content.description}</CardDescription>
      </CardHeader>
      <CardContent>
        <a href="/auth/signin" class="text-foreground hover:decoration-primary text-sm underline underline-offset-4">
          {content.linkText}
        </a>
      </CardContent>
    </Card>
  </main>
</Layout>
