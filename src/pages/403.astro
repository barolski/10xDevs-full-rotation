---
import { ShieldAlert } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";

Astro.response.status = 403;
---

<Layout title="Organizers only">
  <main class="flex flex-1 items-center justify-center p-4">
    <Card className="w-full max-w-sm text-center">
      <CardHeader className="justify-items-center gap-3">
        <span class="bg-warning-soft text-warning-strong inline-flex size-10 items-center justify-center rounded-full">
          <ShieldAlert className="size-5" aria-hidden="true" />
        </span>
        <CardTitle className="text-2xl">
          <h1>Organizers only</h1>
        </CardTitle>
        <CardDescription>This area is available to organizer accounts only.</CardDescription>
      </CardHeader>
      <CardContent>
        <a href="/dashboard" class:list={[buttonVariants({ variant: "outline" })]}>
          Back to dashboard
        </a>
      </CardContent>
    </Card>
  </main>
</Layout>
