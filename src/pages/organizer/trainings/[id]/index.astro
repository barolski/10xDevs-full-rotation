---
import Layout from "@/layouts/Layout.astro";
import TrainingDetails from "@/components/trainings/TrainingDetails.astro";
import CopyLinkButton from "@/components/trainings/CopyLinkButton";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { CircleCheck, CircleX, DoorOpen, Hourglass } from "lucide-react";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import TrainingRatingInput from "@/components/trainings/TrainingRatingInput";
import TeamsPanel from "@/components/trainings/TeamsPanel.astro";
import { loadTraining, unavailableTraining } from "@/lib/training-queries";
import { loadRoster, loadOrSeedTrainingRatings } from "@/lib/signup-queries";
import { loadTeams } from "@/lib/team-queries";
import { MIN_CONFIRMED, splitRoster, type Roster } from "@/lib/signups";
import { rosterLabel } from "@/lib/profiles";
import type { AssignedPlayer } from "@/lib/teams";
import {
  canGenerateTeams,
  canRateTraining,
  isSignupOpen,
  TRAINING_STATUS_BADGE,
  trainingDisplayStatus,
  type TrainingDisplayStatus,
} from "@/lib/trainings";

// One lucide glyph per display status; the label + colour come from TRAINING_STATUS_BADGE.
const STATUS_ICON: Record<TrainingDisplayStatus, typeof CircleCheck> = {
  open: DoorOpen,
  finalizing: Hourglass,
  confirmed: CircleCheck,
  cancelled: CircleX,
};

const now = new Date();
const { training, failed } = await loadTraining(Astro.params.id, Astro.request.headers, Astro.cookies);
const unavailable = unavailableTraining(failed);
if (!training) {
  Astro.response.status = unavailable.status;
}

const shareUrl = training ? new URL(`/t/${training.id}`, Astro.url.origin).toString() : "";
const open = training ? isSignupOpen(new Date(training.starts_at), now) : false;
const display = training ? trainingDisplayStatus(training, now) : null;
const badge = display ? TRAINING_STATUS_BADGE[display] : null;
const StatusIcon = display ? STATUS_ICON[display] : null;
// A rating is a post-training assessment (see canRateTraining): only a confirmed training that has
// already started is ratable, and only its main-list players — the waitlist did not play.
const ratable = training ? canRateTraining(training, now) : false;
// Teams can be generated once the training is confirmed (S-06); the section is hidden otherwise.
const canGenerate = training ? canGenerateTeams(training) : false;

// Main-list count against the minimum, so the organizer sees why it confirmed or cancelled (and,
// while open, live progress toward the minimum). Organizers can read all active sign-ups via RLS.
// On a roster-load failure show a dash, not 0: "0 / min 10" would misread as "nobody signed up".
// When the training is ratable, the main list is rendered with inputs, and opening the page
// guarantees a default-5 rating row for every main-list player (loadOrSeedTrainingRatings).
let mainCount: number | null = null;
let roster: Roster | null = null;
let rosterFailed = false;
let ratingsFailed = false;
let ratings = new Map<string, number>();
if (training) {
  const rosterLoad = await loadRoster(training.id, Astro.request.headers, Astro.cookies);
  rosterFailed = rosterLoad.failed;
  if (!rosterLoad.failed) {
    roster = splitRoster(rosterLoad.entries);
    mainCount = roster.main.length;
    if (ratable) {
      const ratingLoad = await loadOrSeedTrainingRatings(
        training.id,
        roster.main.map((entry) => entry.user_id),
        Astro.request.headers,
        Astro.cookies,
      );
      ratingsFailed = ratingLoad.failed;
      ratings = ratingLoad.ratings;
    }
  }
}

// Teams (S-06): load the persisted split for the confirmed training so the panel can render it.
// Generation itself happens via the island's POST to the teams route, which reloads this page.
let teamAssignments: AssignedPlayer[] = [];
let teamsFailed = false;
if (training && canGenerate) {
  const teamsLoad = await loadTeams(training.id, Astro.request.headers, Astro.cookies);
  teamsFailed = teamsLoad.failed;
  teamAssignments = teamsLoad.assignments;
}

// Ratings apply to the main list only; the waitlist is intentionally not shown here.
const ratedPlayers = roster ? roster.main : [];
const ratingNote =
  display === "cancelled"
    ? "This training was cancelled — there are no ratings."
    : "Player ratings open once the training has taken place.";
const notice = Astro.url.searchParams.has("created")
  ? "Training created. Copy the link and share it with the group."
  : Astro.url.searchParams.has("updated")
    ? "Training updated."
    : null;
---

<Layout title={training?.title ?? unavailable.title}>
  <main class="flex-1 p-4 sm:p-8">
    <div class="mx-auto w-full max-w-md space-y-4">
      <a
        href="/organizer"
        class="text-muted-foreground hover:text-foreground inline-block text-sm underline underline-offset-4"
      >
        Back to trainings
      </a>
      {training ? (
        <>
          {notice && (
            <Alert>
              <AlertDescription>{notice}</AlertDescription>
            </Alert>
          )}
          <Card>
            <CardHeader className="gap-3">
              <div class="flex flex-wrap items-center gap-3">
                <span class:list={[badgeVariants({ variant: badge?.variant })]}>
                  {StatusIcon && <StatusIcon className="size-3.5" aria-hidden="true" />}
                  {badge?.label}
                </span>
                <span class="text-muted-foreground text-sm">
                  {mainCount ?? "—"} / min {MIN_CONFIRMED}
                </span>
              </div>
              <CardTitle className="text-2xl">
                <h1>{training.title}</h1>
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-6">
              <TrainingDetails training={training} now={now} />
              <section class="space-y-2">
                <h2 class="text-sm font-medium">Sign-up link</h2>
                <CopyLinkButton url={shareUrl} client:load />
              </section>
              <section class="space-y-3">
                <h2 class="text-sm font-medium">Player ratings</h2>
                {!ratable ? (
                  <p class="text-muted-foreground text-sm">{ratingNote}</p>
                ) : rosterFailed || ratingsFailed ? (
                  <Alert variant="destructive">
                    <AlertDescription>Could not load ratings. Please refresh the page.</AlertDescription>
                  </Alert>
                ) : ratedPlayers.length === 0 ? (
                  <p class="text-muted-foreground text-sm">No players on the main list.</p>
                ) : (
                  <ul class="divide-border divide-y">
                    {ratedPlayers.map((entry, index) => (
                      <li class="flex items-center justify-between gap-3 py-2">
                        <span class="flex min-w-0 items-center gap-2">
                          <span class="text-muted-foreground w-5 text-right text-xs tabular-nums">{index + 1}</span>
                          <span class="min-w-0 break-words text-sm">{rosterLabel(entry)}</span>
                        </span>
                        <TrainingRatingInput
                          trainingId={training.id}
                          userId={entry.user_id}
                          initialRating={ratings.get(entry.user_id) ?? null}
                          playerLabel={rosterLabel(entry)}
                          client:visible
                        />
                      </li>
                    ))}
                  </ul>
                )}
              </section>
              {canGenerate && (
                <TeamsPanel trainingId={training.id} assignments={teamAssignments} failed={teamsFailed} />
              )}
            </CardContent>
            <CardFooter className="gap-3">
              {open && (
                <a
                  href={`/organizer/trainings/${training.id}/edit`}
                  class:list={[buttonVariants({ variant: "outline" })]}
                >
                  Edit
                </a>
              )}
              <a href={`/t/${training.id}`} class:list={[buttonVariants({ variant: "ghost" })]}>
                Open player view
              </a>
            </CardFooter>
          </Card>
        </>
      ) : (
        <Card>
          <CardHeader>
            <CardTitle className="text-2xl">
              <h1>{unavailable.title}</h1>
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-muted-foreground text-sm">{unavailable.message}</p>
          </CardContent>
        </Card>
      )}
    </div>
  </main>
</Layout>
