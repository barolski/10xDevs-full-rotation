---
import Layout from "@/layouts/Layout.astro";
import TrainingDetails from "@/components/trainings/TrainingDetails.astro";
import CopyLinkButton from "@/components/trainings/CopyLinkButton";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { CircleCheck, CircleX, DoorOpen, Hourglass } from "lucide-react";
import { badgeVariants } from "@/components/ui/badge";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent, CardFooter, CardHeader, CardTitle } from "@/components/ui/card";
import TrainingPlayersTable from "@/components/trainings/TrainingPlayersTable";
import TeamsPanel from "@/components/trainings/TeamsPanel.astro";
import { loadTraining, unavailableTraining } from "@/lib/training-queries";
import { loadRoster, loadOrSeedTrainingRatings, loadRosterStatus } from "@/lib/signup-queries";
import { loadAttendance } from "@/lib/attendance-queries";
import { type AttendanceStatus } from "@/lib/attendance";
import { loadTeams } from "@/lib/team-queries";
import { MAIN_LIST_SIZE, MIN_CONFIRMED, splitRoster } from "@/lib/signups";
import type { RosterStatus } from "@/lib/roster-status";
import { buildPlayerRows, PLAYER_BUCKET_BADGE } from "@/lib/training-players";
import type { AssignedPlayer } from "@/lib/teams";
import {
  canGenerateTeams,
  canRateTraining,
  isSignupOpen,
  TRAINING_STATUS_BADGE,
  trainingDisplayStatus,
  type TrainingDisplayStatus,
} from "@/lib/trainings";

// One lucide glyph per display status; the label + colour come from TRAINING_STATUS_BADGE.
const STATUS_ICON: Record<TrainingDisplayStatus, typeof CircleCheck> = {
  open: DoorOpen,
  finalizing: Hourglass,
  confirmed: CircleCheck,
  cancelled: CircleX,
};

const now = new Date();
const { training, failed } = await loadTraining(Astro.params.id, Astro.request.headers, Astro.cookies);
const unavailable = unavailableTraining(failed);
if (!training) {
  Astro.response.status = unavailable.status;
}

const shareUrl = training ? new URL(`/t/${training.id}`, Astro.url.origin).toString() : "";
const open = training ? isSignupOpen(new Date(training.starts_at), now) : false;
const display = training ? trainingDisplayStatus(training, now) : null;
const badge = display ? TRAINING_STATUS_BADGE[display] : null;
const StatusIcon = display ? STATUS_ICON[display] : null;
// A rating is a post-training assessment (see canRateTraining): only a confirmed training that has
// already started is ratable, and only its main-list players — the waitlist did not play.
const ratable = training ? canRateTraining(training, now) : false;
// The Teams section shows for any confirmed training (so a played session still displays its
// split), but generating/regenerating is offered only before the session starts (S-06).
const showTeams = training?.status === "confirmed";
const canGenerate = training ? canGenerateTeams(training, now) : false;

// Main-list count against the minimum, so the organizer sees why it confirmed or cancelled (and,
// while open, live progress toward the minimum). Organizers can read all active sign-ups via RLS.
// On a roster-load failure show a dash, not 0: "0 / 12" would misread as "nobody signed up".
// When the training is ratable, the main list is rendered with inputs, and opening the page
// guarantees a default-5 rating row for every main-list player (loadOrSeedTrainingRatings).
let mainCount: number | null = null;
let ratingsFailed = false;
let ratings = new Map<string, number>();
// Attendance (S-07): marks for the main list of a played training, same window as ratings.
let attendanceFailed = false;
let attendanceMarks = new Map<string, AttendanceStatus>();
// Roster status (S-08, FR-011): the four buckets, shown for every training status. It is handed the
// sign-up read below instead of repeating it, so the header count and the Roster lists can never
// disagree; only the profile pool and the organizer-only blocked lookup load on top, and a failure
// of those cannot hide attendance or ratings.
let rosterStatus: RosterStatus | null = null;
let rosterStatusFailed = false;
if (training) {
  const rosterLoad = await loadRoster(training.id, Astro.request.headers, Astro.cookies);
  rosterStatusFailed = rosterLoad.failed;
  if (!rosterLoad.failed) {
    const roster = splitRoster(rosterLoad.entries);
    mainCount = roster.main.length;

    const statusLoad = await loadRosterStatus(training.id, rosterLoad.entries, Astro.request.headers, Astro.cookies);
    rosterStatusFailed = statusLoad.failed;
    rosterStatus = statusLoad.status;

    if (ratable) {
      const attendanceLoad = await loadAttendance(training.id, Astro.request.headers, Astro.cookies);
      attendanceFailed = attendanceLoad.failed;
      attendanceMarks = attendanceLoad.marks;

      // Absent players are not rated (their rating row is deleted when they are marked absent), so
      // they are not seeded with a default either. If attendance failed we do not know who is absent,
      // so nothing is seeded (an empty list only reads the existing ratings); the page shows the
      // load-failure alert instead.
      const ratingLoad = await loadOrSeedTrainingRatings(
        training.id,
        attendanceFailed
          ? []
          : roster.main.map((entry) => entry.user_id).filter((userId) => attendanceMarks.get(userId) !== "absent"),
        Astro.request.headers,
        Astro.cookies,
      );
      ratingsFailed = ratingLoad.failed;
      ratings = ratingLoad.ratings;
    }
  }
}

// Teams (S-06): load the persisted split for the confirmed training so the panel can render it.
// Generation itself happens via the island's POST to the teams route, which reloads this page.
let teamAssignments: AssignedPlayer[] = [];
let teamsFailed = false;
if (training && showTeams) {
  const teamsLoad = await loadTeams(training.id, training.starts_at, Astro.request.headers, Astro.cookies);
  teamsFailed = teamsLoad.failed;
  teamAssignments = teamsLoad.assignments;
}

// One row per player in the group; attendance and rating apply to the main list only.
const playerRows = rosterStatus ? buildPlayerRows(rosterStatus, attendanceMarks, ratings) : [];
// Counts above the table, coloured like the Training badges in its rows so the two read together.
const playerCounts = rosterStatus
  ? [
      { ...PLAYER_BUCKET_BADGE.main, label: "Main list", value: `${rosterStatus.main.length} / ${MAIN_LIST_SIZE}` },
      { ...PLAYER_BUCKET_BADGE.waitlist, value: String(rosterStatus.waitlist.length) },
      { ...PLAYER_BUCKET_BADGE.blocked, value: String(rosterStatus.blocked.length) },
      { ...PLAYER_BUCKET_BADGE.noResponse, value: String(rosterStatus.noResponse.length) },
    ]
  : [];
const controlsFailed = ratable && (attendanceFailed || ratingsFailed);
const ratingNote =
  display === "cancelled"
    ? "This training was cancelled — there are no ratings."
    : "Player ratings open once the training has taken place.";
const notice = Astro.url.searchParams.has("created")
  ? "Training created. Copy the link and share it with the group."
  : Astro.url.searchParams.has("updated")
    ? "Training updated."
    : null;
---

<Layout title={training?.title ?? unavailable.title}>
  <main class="flex-1 p-4 sm:p-8">
    <div class="mx-auto w-full max-w-md space-y-4 lg:max-w-4xl">
      {training ? (
        <>
          {notice && (
            <Alert>
              <AlertDescription>{notice}</AlertDescription>
            </Alert>
          )}
          <Card>
            <CardHeader className="gap-3">
              <div class="flex flex-wrap items-center gap-3">
                <span class:list={[badgeVariants({ variant: badge?.variant })]}>
                  {StatusIcon && <StatusIcon className="size-3.5" aria-hidden="true" />}
                  {badge?.label}
                </span>
                <span class="text-muted-foreground text-sm">
                  {mainCount ?? "—"} / {MAIN_LIST_SIZE} (min. {MIN_CONFIRMED})
                </span>
              </div>
              <CardTitle className="text-2xl">
                <h1>{training.title}</h1>
              </CardTitle>
            </CardHeader>
            <CardContent className="space-y-6">
              <TrainingDetails training={training} now={now} />
              <section class="space-y-2">
                <h2 class="text-sm font-medium">Sign-up link</h2>
                <CopyLinkButton url={shareUrl} client:load />
              </section>
              <section class="space-y-3">
                <h2 class="text-sm font-medium">Players</h2>
                {rosterStatusFailed || !rosterStatus ? (
                  <Alert variant="destructive">
                    <AlertDescription>Could not load the players. Please refresh the page.</AlertDescription>
                  </Alert>
                ) : (
                  <>
                    <ul class="flex flex-wrap gap-2" aria-label="Players by status">
                      {playerCounts.map((count) => (
                        <li class:list={[badgeVariants({ variant: count.variant }), "tabular-nums"]}>
                          {count.label} {count.value}
                        </li>
                      ))}
                    </ul>
                    {!ratable && <p class="text-muted-foreground text-sm">{ratingNote}</p>}
                    {controlsFailed && (
                      <Alert variant="destructive">
                        <AlertDescription>
                          Could not load attendance and ratings. Please refresh the page.
                        </AlertDescription>
                      </Alert>
                    )}
                    <TrainingPlayersTable
                      trainingId={training.id}
                      rows={playerRows}
                      ratable={ratable}
                      controlsFailed={controlsFailed}
                      client:load
                    />
                  </>
                )}
              </section>
              {showTeams && (
                <TeamsPanel
                  trainingId={training.id}
                  assignments={teamAssignments}
                  failed={teamsFailed}
                  canGenerate={canGenerate}
                />
              )}
            </CardContent>
            <CardFooter className="gap-3">
              {open && (
                <a
                  href={`/organizer/trainings/${training.id}/edit`}
                  class:list={[buttonVariants({ variant: "outline" })]}
                >
                  Edit
                </a>
              )}
              <a href={`/t/${training.id}`} class:list={[buttonVariants()]}>
                Open player view
              </a>
            </CardFooter>
          </Card>
        </>
      ) : (
        <Card>
          <CardHeader>
            <CardTitle className="text-2xl">
              <h1>{unavailable.title}</h1>
            </CardTitle>
          </CardHeader>
          <CardContent>
            <p class="text-muted-foreground text-sm">{unavailable.message}</p>
          </CardContent>
        </Card>
      )}
    </div>
  </main>
</Layout>
