---
import Layout from "@/layouts/Layout.astro";
import TrainingForm from "@/components/trainings/TrainingForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { loadTraining, unavailableTraining } from "@/lib/training-queries";
import { utcToZonedLocalInput } from "@/lib/time";
import { isSignupOpen, trainingErrorMessage } from "@/lib/trainings";

const { training, failed } = await loadTraining(Astro.params.id, Astro.request.headers, Astro.cookies);
const unavailable = unavailableTraining(failed);
if (!training) {
  Astro.response.status = unavailable.status;
}

const startsAt = training ? new Date(training.starts_at) : null;
const open = startsAt ? isSignupOpen(startsAt, new Date()) : false;
const error = trainingErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title={training ? `Edit: ${training.title}` : unavailable.title}>
  <main class="bg-background text-foreground min-h-screen p-4 sm:p-8">
    <div class="mx-auto w-full max-w-md space-y-4">
      <a
        href={training ? `/organizer/trainings/${training.id}` : "/organizer"}
        class="text-muted-foreground hover:text-foreground inline-block text-sm underline underline-offset-4"
      >
        {training ? "Back to training" : "Back to trainings"}
      </a>
      <Card>
        <CardHeader>
          <CardTitle className="text-2xl">
            <h1>{training ? "Edit training" : unavailable.title}</h1>
          </CardTitle>
        </CardHeader>
        <CardContent>
          {!training || !startsAt ? (
            <p class="text-muted-foreground text-sm">{unavailable.message}</p>
          ) : open ? (
            <TrainingForm
              action={`/api/organizer/trainings/${training.id}`}
              initial={{
                title: training.title,
                startsAtLocal: utcToZonedLocalInput(startsAt),
                location: training.location,
                note: training.note ?? "",
              }}
              serverError={error}
              submitLabel="Save changes"
              pendingText="Saving..."
              client:load
            />
          ) : (
            <Alert>
              <AlertDescription>{trainingErrorMessage("signup_closed")}</AlertDescription>
            </Alert>
          )}
        </CardContent>
      </Card>
    </div>
  </main>
</Layout>
