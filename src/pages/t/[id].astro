---
// The link organizers share on WhatsApp. Middleware sends anonymous visitors to sign-in with ?next=.
import Layout from "@/layouts/Layout.astro";
import PlayerTrainingCard from "@/components/trainings/PlayerTrainingCard.astro";
import { loadTraining, unavailableTraining } from "@/lib/training-queries";

const { isOrganizer } = Astro.locals;
const now = new Date();
const { training, failed } = await loadTraining(Astro.params.id, Astro.request.headers, Astro.cookies);
const unavailable = unavailableTraining(failed);
if (!training) {
  Astro.response.status = unavailable.status;
}
---

<Layout title={training?.title ?? unavailable.title}>
  <main class="mx-auto w-full max-w-md flex-1 p-4 sm:pt-8">
    <PlayerTrainingCard training={training} unavailable={unavailable} now={now} isOrganizer={isOrganizer} />
  </main>
</Layout>
