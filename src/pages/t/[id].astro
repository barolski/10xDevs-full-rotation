---
// The link organizers share on WhatsApp. Middleware sends anonymous visitors to sign-in with ?next=.
import Layout from "@/layouts/Layout.astro";
import PlayerTrainingCard from "@/components/trainings/PlayerTrainingCard.astro";
import { loadRoster, loadBlockInfo } from "@/lib/signup-queries";
import { loadTraining, unavailableTraining } from "@/lib/training-queries";
import { placementOf, splitRoster } from "@/lib/signups";
import { isSignupOpen } from "@/lib/trainings";

const { isOrganizer, user } = Astro.locals;
const now = new Date();
const { training, failed } = await loadTraining(Astro.params.id, Astro.request.headers, Astro.cookies);
const unavailable = unavailableTraining(failed);
if (!training) {
  Astro.response.status = unavailable.status;
}

// Only worth a query once the training is known to exist.
const rosterLoad = training
  ? await loadRoster(training.id, Astro.request.headers, Astro.cookies)
  : { entries: [], failed: false };
const roster = splitRoster(rosterLoad.entries);
const placement = placementOf(roster, user?.id);

// Only a logged-in player who could otherwise sign up (training open, not already placed) needs the
// lockout check — show the block reason instead of the sign-up button (FR-010). Avoid the RPC otherwise.
const open = training ? isSignupOpen(new Date(training.starts_at), now) : false;
const block =
  training && user && open && !placement
    ? await loadBlockInfo(training.id, Astro.request.headers, Astro.cookies)
    : { blocked: false, absences: 0 };

const params = Astro.url.searchParams;
const notice = params.has("signed_up") ? "signed_up" : params.has("withdrawn") ? "withdrawn" : null;
---

<Layout title={training?.title ?? unavailable.title}>
  {/* Phone-first single column; from lg the card gets room for details and rosters side by side. */}
  <main class="mx-auto w-full max-w-md flex-1 p-4 sm:pt-8 lg:max-w-3xl">
    <PlayerTrainingCard
      training={training}
      unavailable={unavailable}
      now={now}
      isOrganizer={isOrganizer}
      roster={roster}
      placement={placement}
      userId={user?.id}
      rosterFailed={rosterLoad.failed}
      blocked={block.blocked}
      absences={block.absences}
      notice={notice}
      error={params.get("error")}
    />
  </main>
</Layout>
