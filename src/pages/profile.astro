---
// The player's own profile: the name rosters show, plus the player's court positions. The
// organizer-set rating is per-training and lives on the organizer's training page, not here.
import { CircleCheck } from "lucide-react";
import Layout from "@/layouts/Layout.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { t } from "@/i18n";
import { loadProfile, unavailableProfile } from "@/lib/signup-queries";
import { profileErrorMessage } from "@/lib/profiles";

const { user, lang } = Astro.locals;
const d = t(lang);
// Middleware guarantees a session on /profile; loadProfile guards the id if that ever changes.
const { profile, failed } = await loadProfile(user?.id, Astro.request.headers, Astro.cookies);
const unavailable = unavailableProfile(failed, lang);
if (!profile) {
  Astro.response.status = unavailable.status;
}

const params = Astro.url.searchParams;
const saved = params.has("saved");
const error = profileErrorMessage(params.get("error"), lang);
---

<Layout title={d.profile.pageTitle}>
  <main class="mx-auto w-full max-w-md flex-1 p-4 sm:pt-8">
    <Card>
      <CardHeader>
        <CardTitle className="text-2xl">
          <h1>{d.profile.heading}</h1>
        </CardTitle>
        <CardDescription>
          {d.common.signedInAs} <span class="text-foreground font-medium break-all">{user?.email}</span>
        </CardDescription>
      </CardHeader>
      <CardContent className="space-y-4">
        {saved && !error && (
          <Alert>
            <CircleCheck />
            <AlertDescription>{d.profile.saved}</AlertDescription>
          </Alert>
        )}
        {profile ? (
          <ProfileForm
            lang={lang}
            initialNickname={profile.nickname}
            initialPrimary={profile.primary_position}
            initialSecondary={profile.secondary_position}
            serverError={error}
            client:load
          />
        ) : (
          <p class="text-muted-foreground text-sm">{unavailable.message}</p>
        )}
      </CardContent>
    </Card>
  </main>
</Layout>
