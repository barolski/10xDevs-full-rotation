---
// Dev-only visual gate for the player training view (/t/[id]): every state on one page, rendered
// through the same PlayerTrainingCard the page uses.
// Theme is forced for the whole page (?theme=light|dark) because `dark:` utilities match descendants of `.dark`.
// Hover and focus cannot be forced statically; capture those by hovering/tabbing on this page.
import Layout from "@/layouts/Layout.astro";
import ThemeToggle from "@/components/ThemeToggle";
import PlayerTrainingCard from "@/components/trainings/PlayerTrainingCard.astro";
import { unavailableTraining } from "@/lib/training-queries";
import { MAIN_LIST_SIZE, placementOf, splitRoster, type SignupEntry } from "@/lib/signups";
import type { Training } from "@/lib/trainings";

// Production: empty 404. No frontmatter `return` here; it crashes typescript-eslint on .astro files.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";
const { lang } = Astro.locals;

// Fixed clock so the open/closed states don't drift: Thu 1 Oct 2026, 12:00 Warsaw.
const now = new Date("2026-10-01T10:00:00Z");
const base: Training = {
  id: "00000000-0000-0000-0000-000000000001",
  title: "Thursday volleyball",
  starts_at: "2026-10-02T17:00:00Z",
  location: "SP 12 sports hall, ul. Sportowa 4, Kraków",
  note: "Bring indoor shoes. Hall doors open at 18:45.",
  status: "open",
};

// The signed-in player these states are seen as.
const ME = "00000000-0000-0000-0000-0000000000aa";
const NICKNAMES = [
  "kuba",
  "Marta",
  "grzegorz.brzeczyszczykiewicz",
  "Ola",
  "Piotrek",
  "Zosia",
  "Bartek",
  "Ania",
  "Tomek",
  "Kasia",
  "Michał",
  "Weronika",
  "Sebastian",
  "Ewa",
];

function entries(count: number, options: { includeMeAt?: number } = {}): SignupEntry[] {
  return Array.from({ length: count }, (_, index) => {
    const isMe = options.includeMeAt === index + 1;
    return {
      id: `signup-${index + 1}`,
      user_id: isMe ? ME : `user-${index + 1}`,
      position: index + 1,
      nickname: isMe ? "you (kuba)" : NICKNAMES[index % NICKNAMES.length],
    };
  });
}

interface State {
  label: string;
  training: Training | null;
  failed?: boolean;
  organizer?: boolean;
  signups?: SignupEntry[];
  rosterFailed?: boolean;
  notice?: "signed_up" | "withdrawn" | null;
  error?: string | null;
  // Defaults to the signed-in player (ME); null renders the view signed out.
  userId?: string | null;
  // The no-show lockout: replaces the sign-up action with the reason.
  blocked?: boolean;
  absences?: number;
}

const states: State[] = [
  { label: "Open, not signed up, spots left", training: base, signups: entries(5) },
  {
    label: "Signed up, main list",
    training: base,
    signups: entries(7, { includeMeAt: 4 }),
    notice: "signed_up",
  },
  {
    label: "Main list full, not signed up",
    training: { ...base, id: "00000000-0000-0000-0000-000000000002" },
    signups: entries(MAIN_LIST_SIZE),
  },
  {
    label: "Signed up, waitlist",
    training: base,
    signups: entries(MAIN_LIST_SIZE + 2, { includeMeAt: MAIN_LIST_SIZE + 1 }),
  },
  { label: "Open, minimum reached, not signed up", training: base, signups: entries(10) },
  { label: "Signed out (no account)", training: base, signups: entries(5), userId: null },
  { label: "Blocked player (2 absences)", training: base, signups: entries(5), blocked: true, absences: 2 },
  { label: "Nobody signed up yet", training: base, signups: [] },
  { label: "Just withdrawn", training: base, signups: entries(6), notice: "withdrawn" },
  {
    label: "Closed (starts in under 3 h), signed up",
    training: { ...base, id: "00000000-0000-0000-0000-000000000003", starts_at: "2026-10-01T12:00:00Z", note: null },
    signups: entries(10, { includeMeAt: 2 }),
  },
  {
    // Window closed, status still `open`: the transient state before the cron writes the outcome.
    label: "Finalizing (window closed, awaiting outcome)",
    training: {
      ...base,
      id: "00000000-0000-0000-0000-000000000005",
      starts_at: "2026-10-01T12:00:00Z",
      status: "open",
    },
    signups: entries(9, { includeMeAt: 2 }),
  },
  {
    label: "Confirmed",
    training: {
      ...base,
      id: "00000000-0000-0000-0000-000000000006",
      starts_at: "2026-10-01T12:00:00Z",
      status: "confirmed",
    },
    signups: entries(11, { includeMeAt: 2 }),
  },
  {
    // Confirmed and not yet started: sign-ups are closed, but a main-list player can still withdraw
    // (freeing a slot promotes the first waitlister, FR-016), so Withdraw shows with the absence note.
    label: "Confirmed, main list, can withdraw",
    training: {
      ...base,
      id: "00000000-0000-0000-0000-000000000008",
      starts_at: "2026-10-01T12:00:00Z",
      status: "confirmed",
    },
    signups: entries(MAIN_LIST_SIZE + 1, { includeMeAt: 3 }),
  },
  {
    // Same window, but the signed-in player is on the waitlist: they may withdraw too (no promotion).
    label: "Confirmed, waitlist, can withdraw",
    training: {
      ...base,
      id: "00000000-0000-0000-0000-000000000009",
      starts_at: "2026-10-01T12:00:00Z",
      status: "confirmed",
    },
    signups: entries(MAIN_LIST_SIZE + 1, { includeMeAt: MAIN_LIST_SIZE + 1 }),
  },
  {
    label: "Cancelled",
    training: {
      ...base,
      id: "00000000-0000-0000-0000-000000000007",
      starts_at: "2026-10-01T12:00:00Z",
      status: "cancelled",
    },
    signups: entries(4, { includeMeAt: 2 }),
  },
  {
    label: "Open, no note, long title and location",
    training: {
      ...base,
      id: "00000000-0000-0000-0000-000000000004",
      title: "Friday evening mixed volleyball for the whole group, beginners welcome",
      location: "Centrum Sportowo-Rekreacyjne Politechniki Krakowskiej, hala nr 2, ul. Kamieńskiego 17, Kraków",
      note: null,
    },
    signups: entries(3),
  },
  { label: "Error: already signed up", training: base, signups: entries(5), error: "already_signed_up" },
  { label: "Error: overlapping sign-up", training: base, signups: entries(5), error: "overlapping_signup" },
  { label: "Error: blocked player", training: base, signups: entries(5), error: "player_blocked" },
  { label: "Error: sign-ups closed", training: base, signups: entries(5), error: "signup_closed" },
  { label: "Error: unknown code (generic)", training: base, signups: entries(5), error: "not-a-real-code" },
  { label: "Roster load failed", training: base, signups: [], rosterFailed: true },
  { label: "Organizer viewing (Manage)", training: base, signups: entries(5), organizer: true },
  { label: "Not found", training: null },
  { label: "Load failed", training: null, failed: true },
];
---

{isDev && (
  <Layout title="Kitchen sink: training view" theme={theme}>
    <main class="flex-1 space-y-8 p-4 sm:p-8">
      <header class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Training view kitchen sink ({theme})</h1>
        <nav class="text-muted-foreground flex gap-3 text-sm">
          <a class="text-foreground underline underline-offset-4" href="?theme=light">
            Light
          </a>
          <a class="text-foreground underline underline-offset-4" href="?theme=dark">
            Dark
          </a>
          <a class="text-foreground underline underline-offset-4" href="/dev/profile-kitchen-sink">
            Profile sink
          </a>
        </nav>
      </header>
      <section class="space-y-3">
        <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Theme toggle (full, compact)</h2>
        <div class="flex flex-wrap items-center gap-3">
          <ThemeToggle lang={lang} client:load />
          <ThemeToggle lang={lang} compact client:load />
        </div>
      </section>
      <div class="grid items-start gap-6 md:grid-cols-2 xl:grid-cols-3">
        {states.map((state) => {
          const roster = splitRoster(state.signups ?? []);
          return (
            <section class="max-w-md space-y-2">
              <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">{state.label}</h2>
              <PlayerTrainingCard
                training={state.training}
                unavailable={unavailableTraining(state.failed ?? false, lang)}
                now={now}
                isOrganizer={state.organizer ?? false}
                roster={roster}
                placement={state.userId === null ? null : placementOf(roster, state.userId ?? ME)}
                userId={state.userId === null ? undefined : (state.userId ?? ME)}
                blocked={state.blocked ?? false}
                absences={state.absences ?? 0}
                rosterFailed={state.rosterFailed ?? false}
                notice={state.notice ?? null}
                error={state.error ?? null}
              />
            </section>
          );
        })}
      </div>
      {/* The cards above are phone-width. This one has the room the real page has from lg up, where the
          panel's container query switches to details on the left and rosters on the right. */}
      <section class="space-y-2">
        <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">
          Wide layout (lg and up): details beside the rosters
        </h2>
        <div class="max-w-3xl">
          <PlayerTrainingCard
            training={base}
            unavailable={unavailableTraining(false, lang)}
            now={now}
            roster={splitRoster(entries(MAIN_LIST_SIZE + 2, { includeMeAt: MAIN_LIST_SIZE + 1 }))}
            placement={placementOf(splitRoster(entries(MAIN_LIST_SIZE + 2, { includeMeAt: MAIN_LIST_SIZE + 1 })), ME)}
            userId={ME}
          />
        </div>
      </section>
    </main>
  </Layout>
)}
