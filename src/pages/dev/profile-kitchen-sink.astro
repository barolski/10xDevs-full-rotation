---
// Dev-only visual gate for /profile: every state of the profile form on one page, rendered through the
// same island the page ships. Theme is forced for the whole page (?theme=light|dark).
// Hover, focus and the pending button cannot be forced statically; capture those by interacting here.
import Layout from "@/layouts/Layout.astro";
import ProfileForm from "@/components/profile/ProfileForm";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from "@/components/ui/card";
import { CircleCheck } from "lucide-react";
import { NICKNAME_MAX, profileErrorMessage } from "@/lib/profiles";

// Production: empty 404. No frontmatter `return` here; it crashes typescript-eslint on .astro files.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";

const states: { label: string; nickname: string; error?: string | null; saved?: boolean }[] = [
  { label: "Seeded nickname (from the e-mail local part)", nickname: "jan.kowalski91" },
  { label: "Edited nickname", nickname: "Kuba" },
  { label: "Saved", nickname: "Kuba", saved: true },
  { label: "Server error: name too long", nickname: "x".repeat(NICKNAME_MAX + 1), error: "nickname_too_long" },
  { label: "Server error: name required", nickname: "", error: "missing_nickname" },
  { label: "Server error: save failed", nickname: "Kuba", error: "save_failed" },
  { label: "Longest accepted nickname", nickname: "x".repeat(NICKNAME_MAX) },
];
---

{isDev && (
  <Layout title="Kitchen sink: profile" theme={theme}>
    <main class="flex-1 space-y-8 p-4 sm:p-8">
      <header class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Profile kitchen sink ({theme})</h1>
        <nav class="text-muted-foreground flex gap-3 text-sm">
          <a class="text-foreground underline underline-offset-4" href="?theme=light">
            Light
          </a>
          <a class="text-foreground underline underline-offset-4" href="?theme=dark">
            Dark
          </a>
          <a class="text-foreground underline underline-offset-4" href="/dev/training-kitchen-sink">
            Training sink
          </a>
        </nav>
      </header>
      <div class="grid items-start gap-6 md:grid-cols-2 xl:grid-cols-3">
        {states.map((state) => (
          <section class="max-w-md space-y-2">
            <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">{state.label}</h2>
            <Card>
              <CardHeader>
                <CardTitle className="text-2xl">
                  <h3>Your profile</h3>
                </CardTitle>
                <CardDescription>
                  Signed in as <span class="text-foreground font-medium break-all">player@example.com</span>
                </CardDescription>
              </CardHeader>
              <CardContent className="space-y-4">
                {state.saved && (
                  <Alert>
                    <CircleCheck />
                    <AlertDescription>Profile saved.</AlertDescription>
                  </Alert>
                )}
                <ProfileForm
                  initialNickname={state.nickname}
                  serverError={profileErrorMessage(state.error ?? null)}
                  client:load
                />
              </CardContent>
            </Card>
          </section>
        ))}
      </div>
    </main>
  </Layout>
)}
