---
// Dev-only visual gate for the organizer per-training rating control: every state of
// TrainingRatingInput on one page, rendered through the same island the training page ships.
// Theme is forced for the whole page (?theme=light|dark). Saving/saved/error are transient
// states that can't be produced statically, so they are seeded via seedStatus/seedMessage.
import Layout from "@/layouts/Layout.astro";
import TrainingRatingInput from "@/components/trainings/TrainingRatingInput";
import { Card, CardContent, CardHeader, CardTitle } from "@/components/ui/card";
import { ratingErrorMessage } from "@/lib/ratings";

// Production: empty 404. No frontmatter `return` here; it crashes typescript-eslint on .astro files.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";

// Fixed sample ids: the island posts to the ratings API on interaction, but this page exists to
// screenshot the visual states, not to persist.
const TRAINING_ID = "00000000-0000-0000-0000-000000000001";

interface State {
  label: string;
  nickname: string;
  userId: string;
  initialRating?: number | null;
  seedStatus?: "idle" | "saving" | "saved" | "error";
  seedMessage?: string;
}

const states: State[] = [
  {
    label: "Unrated (defaults to 5)",
    nickname: "Kuba",
    userId: "00000000-0000-0000-0000-0000000000a1",
    initialRating: null,
  },
  { label: "Rated", nickname: "Ola", userId: "00000000-0000-0000-0000-0000000000a2", initialRating: 7.5 },
  {
    label: "Saving",
    nickname: "Marek",
    userId: "00000000-0000-0000-0000-0000000000a3",
    initialRating: 6,
    seedStatus: "saving",
  },
  {
    label: "Saved",
    nickname: "Ewa",
    userId: "00000000-0000-0000-0000-0000000000a4",
    initialRating: 6,
    seedStatus: "saved",
  },
  {
    label: "Error",
    nickname: "Tomek",
    userId: "00000000-0000-0000-0000-0000000000a5",
    initialRating: 8,
    seedStatus: "error",
    seedMessage: ratingErrorMessage("invalid_rating") ?? undefined,
  },
];
---

{isDev && (
  <Layout title="Kitchen sink: organizer ratings" theme={theme}>
    <main class="flex-1 space-y-8 p-4 sm:p-8">
      <header class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Organizer ratings kitchen sink ({theme})</h1>
        <nav class="text-muted-foreground flex gap-3 text-sm">
          <a class="text-foreground underline underline-offset-4" href="?theme=light">
            Light
          </a>
          <a class="text-foreground underline underline-offset-4" href="?theme=dark">
            Dark
          </a>
          <a class="text-foreground underline underline-offset-4" href="/dev/profile-kitchen-sink">
            Profile sink
          </a>
        </nav>
      </header>

      <div class="grid items-start gap-6 md:grid-cols-2">
        <section class="space-y-2">
          <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Roster with ratings</h2>
          <Card>
            <CardHeader>
              <CardTitle className="text-sm">
                <h3>Main list</h3>
              </CardTitle>
            </CardHeader>
            <CardContent>
              <ul class="divide-border divide-y">
                {states.map((state, index) => (
                  <li class="flex items-center justify-between gap-3 py-2">
                    <span class="flex min-w-0 items-center gap-2">
                      <span class="text-muted-foreground w-5 text-right text-xs tabular-nums">{index + 1}</span>
                      <span class="min-w-0 break-words text-sm">{state.nickname}</span>
                    </span>
                    <TrainingRatingInput
                      trainingId={TRAINING_ID}
                      userId={state.userId}
                      initialRating={state.initialRating ?? null}
                      playerLabel={state.nickname}
                      seedStatus={state.seedStatus}
                      seedMessage={state.seedMessage}
                      client:load
                    />
                  </li>
                ))}
              </ul>
            </CardContent>
          </Card>
        </section>

        <div class="space-y-6">
          {states.map((state) => (
            <section class="space-y-2">
              <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">{state.label}</h2>
              <Card>
                <CardContent className="pt-6">
                  <TrainingRatingInput
                    trainingId={TRAINING_ID}
                    userId={state.userId}
                    initialRating={state.initialRating ?? null}
                    playerLabel={state.nickname}
                    seedStatus={state.seedStatus}
                    seedMessage={state.seedMessage}
                    client:load
                  />
                </CardContent>
              </Card>
            </section>
          ))}

          <section class="space-y-2">
            <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Empty roster</h2>
            <Card>
              <CardContent className="pt-6">
                <p class="text-muted-foreground text-sm">No sign-ups yet.</p>
              </CardContent>
            </Card>
          </section>
        </div>
      </div>
    </main>
  </Layout>
)}
