---
// Dev-only visual gate for S-08: every roster state rendered through the same RosterStatusPanel the
// training screen ships, from fixtures passed through the real rosterStatus() rule. Theme forced via
// ?theme=light|dark. 404 in production.
import Layout from "@/layouts/Layout.astro";
import RosterStatusPanel from "@/components/trainings/RosterStatusPanel.astro";
import { rosterStatus, type RosterPoolEntry } from "@/lib/roster-status";
import type { SignupEntry } from "@/lib/signups";

const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";

// Stable fixture ids. Each player is one profile; `signedUp` decides whether they have an active sign-up.
const player = (n: number, nickname: string): RosterPoolEntry => ({
  user_id: `00000000-0000-0000-0000-0000000000${n.toString(16).padStart(2, "0")}`,
  nickname,
});
const signup = (p: RosterPoolEntry, position: number): SignupEntry => ({
  id: `signup-${position}`,
  user_id: p.user_id,
  position,
  nickname: p.nickname,
});

const organizer = player(1, "Organizer");
const kuba = player(2, "Kuba");
const bartek = player(3, "Bartek (blocked)");
const kasia = player(4, "Kasia (blocked)");
const nikodem = player(5, "Nikodem (no response)");
const wojtek = player(6, "Wojtek (withdrew)");
const ola = player(7, "Ola (signed up, blocked)");

// A full training: 13 active sign-ups, Ola is one of them while blocked (she keeps her place).
const fullNames = [
  "Ola (signed up, blocked)",
  "Marek",
  "Ewa",
  "Tomek",
  "Ania",
  "Piotr",
  "Zofia",
  "Adam",
  "Ada",
  "Jan",
  "Iga",
  "Olek",
  "Michał",
];
const fullPlayers: RosterPoolEntry[] = fullNames.map((nickname, i) => (i === 0 ? ola : player(20 + i, nickname)));
const fullEntries = fullPlayers.map((p, i) => signup(p, i + 1));

const states = [
  {
    label: "Empty training",
    status: rosterStatus([], [organizer], new Set()),
    failed: false,
  },
  {
    label: "Full main list, waitlist, blocked and no response (Ola signed up while blocked stays on main)",
    status: rosterStatus(
      fullEntries,
      [...fullPlayers, bartek, nikodem, wojtek, organizer],
      new Set([bartek.user_id, ola.user_id]),
    ),
    failed: false,
  },
  {
    label: "Blocked only (no sign-ups)",
    status: rosterStatus([], [kasia, bartek, kuba], new Set([kasia.user_id, bartek.user_id])),
    failed: false,
  },
  {
    label: "Load failed",
    status: null,
    failed: true,
  },
];
---

{isDev && (
  <Layout title="Kitchen sink: roster status" theme={theme}>
    <main class="flex-1 space-y-8 p-4 sm:p-8">
      <header class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Roster status kitchen sink ({theme})</h1>
        <nav class="text-muted-foreground flex gap-3 text-sm">
          <a class="text-foreground underline underline-offset-4" href="?theme=light">
            Light
          </a>
          <a class="text-foreground underline underline-offset-4" href="?theme=dark">
            Dark
          </a>
        </nav>
      </header>

      {states.map((state) => (
        <div class="max-w-3xl space-y-2">
          <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">{state.label}</h2>
          <RosterStatusPanel status={state.status} failed={state.failed} />
        </div>
      ))}
    </main>
  </Layout>
)}
