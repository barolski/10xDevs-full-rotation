---
// Dev-only visual gate for S-07: every AttendanceToggle state + the blocked sign-up view, rendered
// through the same components the pages ship. Theme forced via ?theme=light|dark. 404 in production.
import Layout from "@/layouts/Layout.astro";
import AttendanceToggle from "@/components/trainings/AttendanceToggle";
import PlayerTrainingCard from "@/components/trainings/PlayerTrainingCard.astro";
import { attendanceErrorMessage } from "@/lib/attendance";
import { splitRoster, type SignupEntry } from "@/lib/signups";
import { unavailableTraining } from "@/lib/training-queries";
import type { Training } from "@/lib/trainings";

const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

const theme = Astro.url.searchParams.get("theme") === "dark" ? "dark" : "light";
const TRAINING_ID = "00000000-0000-0000-0000-000000000001";

type SaveState = "idle" | "saving" | "saved" | "error";
interface ToggleState {
  label: string;
  nickname: string;
  userId: string;
  initialStatus?: "present" | "absent" | null;
  seedStatus?: SaveState;
  seedMessage?: string;
}

const toggleStates: ToggleState[] = [
  { label: "Unmarked", nickname: "Kuba", userId: "00000000-0000-0000-0000-0000000000a1", initialStatus: null },
  { label: "Present", nickname: "Ola", userId: "00000000-0000-0000-0000-0000000000a2", initialStatus: "present" },
  { label: "Absent", nickname: "Marek", userId: "00000000-0000-0000-0000-0000000000a3", initialStatus: "absent" },
  {
    label: "Saving",
    nickname: "Ewa",
    userId: "00000000-0000-0000-0000-0000000000a4",
    initialStatus: null,
    seedStatus: "saving",
  },
  {
    label: "Saved",
    nickname: "Tomek",
    userId: "00000000-0000-0000-0000-0000000000a5",
    initialStatus: "present",
    seedStatus: "saved",
  },
  {
    label: "Error",
    nickname: "Ania",
    userId: "00000000-0000-0000-0000-0000000000a6",
    initialStatus: null,
    seedStatus: "error",
    seedMessage: attendanceErrorMessage("save_failed") ?? undefined,
  },
];

// Blocked sign-up view: an open training where the viewer is blocked (sees the reason, not Sign up).
const now = new Date("2026-10-01T10:00:00Z");
const openTraining: Training = {
  id: TRAINING_ID,
  title: "Thursday volleyball",
  starts_at: "2026-10-02T17:00:00Z",
  location: "SP 12 sports hall",
  note: null,
  status: "open",
};
const signups: SignupEntry[] = Array.from({ length: 5 }, (_, i) => ({
  id: `signup-${i + 1}`,
  user_id: `user-${i + 1}`,
  position: i + 1,
  nickname: ["Ola", "Marek", "Ewa", "Tomek", "Ania"][i],
}));
const blockedRoster = splitRoster(signups);
---

{isDev && (
  <Layout title="Kitchen sink: attendance" theme={theme}>
    <main class="flex-1 space-y-8 p-4 sm:p-8">
      <header class="flex flex-wrap items-center justify-between gap-3">
        <h1 class="text-2xl font-semibold">Attendance kitchen sink ({theme})</h1>
        <nav class="text-muted-foreground flex gap-3 text-sm">
          <a class="text-foreground underline underline-offset-4" href="?theme=light">
            Light
          </a>
          <a class="text-foreground underline underline-offset-4" href="?theme=dark">
            Dark
          </a>
        </nav>
      </header>

      <section class="space-y-2">
        <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Attendance toggle</h2>
        <ul class="divide-border max-w-md divide-y rounded-xl border p-4">
          {toggleStates.map((state) => (
            <li class="flex items-center justify-between gap-3 py-2">
              <span class="flex min-w-0 items-center gap-2">
                <span class="text-muted-foreground w-16 text-xs">{state.label}</span>
                <span class="min-w-0 break-words text-sm">{state.nickname}</span>
              </span>
              <AttendanceToggle
                trainingId={TRAINING_ID}
                userId={state.userId}
                initialStatus={state.initialStatus ?? null}
                playerLabel={state.nickname}
                seedStatus={state.seedStatus}
                seedMessage={state.seedMessage}
                client:load
              />
            </li>
          ))}
        </ul>
      </section>

      <section class="max-w-md space-y-2">
        <h2 class="text-muted-foreground text-xs font-medium tracking-wide uppercase">Blocked player (sign-up view)</h2>
        <PlayerTrainingCard
          training={openTraining}
          unavailable={unavailableTraining(false)}
          now={now}
          roster={blockedRoster}
          placement={null}
          userId="00000000-0000-0000-0000-0000000000ff"
          blocked={true}
          absences={2}
        />
      </section>
    </main>
  </Layout>
)}
